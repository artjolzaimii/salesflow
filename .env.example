# Copy to .env (git-ignored). Server-side only: never prefix with NEXT_PUBLIC_.
# Local Docker database from docker-compose.yml (development credentials only).
DATABASE_URL="postgresql://salesflow:salesflow_dev@localhost:5433/salesflow?schema=public"

# Auth.js session encryption key. Required. Generate a unique value per
# environment and keep it secret:  openssl rand -base64 33
AUTH_SECRET=""
# Trust the Host header for Auth.js callbacks. Fine locally and behind a proxy
# you control; on Vercel it is detected automatically.
AUTH_TRUST_HOST=true

# Development seed only (prisma/seed.ts). Password for the four demo accounts.
# The seed refuses to run with NODE_ENV=production.
SEED_DEMO_PASSWORD="ChangeMe-LocalDemo-2026!"

# AI assistant (Phase 5F, docs/assistant.md). Server-side only. Leave the key
# empty to keep the assistant disabled; the screen then says it isn't configured.
ANTHROPIC_API_KEY=
# Optional overrides (defaults shown):
# ASSISTANT_MODEL=claude-opus-5-5
# ASSISTANT_EFFORT=medium
# ASSISTANT_MAX_OUTPUT_TOKENS=8000
# ASSISTANT_MAX_ROUNDS=6
# ASSISTANT_MAX_TOOL_CALLS=8
# ASSISTANT_TIMEOUT_MS=90000
# ASSISTANT_REQUESTS_PER_HOUR=30
# Phase 6A limits (defaults shown; see docs/security.md):
# ASSISTANT_FALLBACKS=off          # "default" enables the refusal fallback (explicit approval needed)
# ASSISTANT_MAX_CONCURRENT=10
# ASSISTANT_DAILY_USD_PER_USER=5
# ASSISTANT_DAILY_USD_TOTAL=50

# Database pool (per server instance) and query limits:
# DATABASE_POOL_MAX=10
# DATABASE_CONNECT_TIMEOUT_MS=10000
# DATABASE_STATEMENT_TIMEOUT_MS=30000
