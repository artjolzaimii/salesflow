{
  "name": "salesflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preflight": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/preflight.mjs",
    "start:production": "npm run preflight && next start",
    "lint": "eslint",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:verify": "docker compose exec -T postgres psql -U salesflow -d salesflow -v ON_ERROR_STOP=1 < scripts/verify.sql",
    "db:verify:guards": "tsx scripts/verify-guards.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/unit tests/db"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "otpauth": "9.6.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright-core": "1.56.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "4.1.12"
  }
}
